# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# --- Sensitive/secret files (API keys, signing, env) ---
# Android signing keys and properties
android/key.properties
!android/key.properties.example
**/*.jks
**/*.keystore

# Android local SDK path file
**/local.properties

# Firebase / Google services configs (keep out of VCS)
android/app/google-services.json
ios/Runner/GoogleService-Info.plist

# Env files (for dotenv or similar)
.env
.env.*

# Common Dart secrets files (if you create them)
lib/**/secrets.dart
lib/**/secrets_*.dart
lib/**/api_keys.dart
lib/**/api_keys_*.dart
